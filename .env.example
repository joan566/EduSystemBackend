# Copia este archivo a .env (cp .env.example .env) y pon tus valores. Spring Boot lo carga solo al arrancar desde la
# raíz del proyecto; .env está en .gitignore y nunca debe subirse.
DB_URL=jdbc:postgresql://localhost:5432/edusistem
DB_USERNAME=edusistem
DB_PASSWORD=change-me
# Mínimo 32 caracteres y aleatorio: openssl rand -base64 48 (la app no arranca con este valor de ejemplo)
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION_DAYS=30
# Orígenes permitidos por CORS (coma). Vacío = desactivado. Ej.: http://localhost:3000,https://app.midominio.com
CORS_ALLOWED_ORIGINS=
LOGIN_MAX_ATTEMPTS_PER_EMAIL=5
LOGIN_MAX_ATTEMPTS_PER_IP=50
LOGIN_LOCK_WINDOW_MINUTES=15
STORAGE_PATH=./storage
# Cifrado de los archivos guardados (AES-256): openssl rand -base64 32. Vacío = sin cifrar (solo en desarrollo).
# Guárdala en un gestor de secretos, aparte de los backups: sin ella los archivos cifrados son irrecuperables.
STORAGE_ENCRYPTION_KEY=
# Días que se conserva la auditoría (y la de intentos de login sin usuario, que guardan el correo escrito)
AUDIT_RETENTION_DAYS=730
AUDIT_ANONYMOUS_RETENTION_DAYS=30
# Días que se conservan los Excel importados y sus informes de errores
IMPORT_FILE_RETENTION_DAYS=30
# Swagger UI y /v3/api-docs: true solo en desarrollo local; false en producción
API_DOCS_ENABLED=false
# "native" si la app está detrás de un proxy inverso (para obtener la IP real del cliente); "none" si no
FORWARD_HEADERS_STRATEGY=none
# Correo por Resend (códigos de verificación de cuenta y de recuperación de contraseña). Con MAIL_ENABLED=false no se
# envía nada y las cuentas nuevas no pueden verificarse. Con true, RESEND_API_KEY y RESEND_FROM son obligatorios.
MAIL_ENABLED=false
# API key de https://resend.com/api-keys (nunca la subas al repositorio)
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend, p. ej. EduSistem <no-reply@tudominio.com>. Para pruebas:
# onboarding@resend.dev (solo entrega al correo de tu propia cuenta de Resend)
RESEND_FROM=
